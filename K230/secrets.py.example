# secrets.py —— 本地私有配置（模板）
#
# 使用方法：
#   1. 把本文件复制为同目录下的 secrets.py
#   2. 填入你自己的 WiFi、服务器与 MQTT broker 信息
#   3. secrets.py 已被仓库根目录的 .gitignore 忽略，不会被提交
#
# 注意：本文件（secrets.py.example）是要提交到仓库的模板，请勿在此填入真实密码。

# ──────────────── WiFi ────────────────
WIFI_SSID = "your-wifi-ssid"
WIFI_PASS = "your-wifi-password"

# ──────────────── TCP 图像上传服务器 ────────────────
# K230 把识别到病害时抓拍的 JPEG 通过 TCP 发到这台主机
TCP_SERVER_IP = "192.0.2.10"
TCP_SERVER_PORT = 8888

# ──────────────── MQTT ────────────────
# 可以填公共测试 broker（如 broker.emqx.io），也可以填自己的 mosquitto/EMQX
MQTT_BROKER = "broker.example.com"
MQTT_PORT = 1883

# 主题需与 ESP8266 端 secrets.h 中的配置保持一致
MQTT_TOPIC = "your_sub_topic"       # K230 订阅：接收下行指令（'1' / '2' / '3' ...）
MQTT_PUB_TOPIC = "your_pub_topic"   # K230 发布：上线握手 / 状态

# broker 不需要账号密码时保持 None
MQTT_USER = None
MQTT_PASS = None
