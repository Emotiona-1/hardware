/*
 * secrets.h —— 本地私有配置（模板）
 *
 * 使用方法：
 *   1. 把本文件复制为同目录下的 secrets.h
 *   2. 填入你自己的 WiFi、MQTT broker 与主题
 *   3. secrets.h 已被仓库根目录的 .gitignore 忽略，不会被提交
 *
 * 注意：本文件（secrets.h.example）是要提交到仓库的模板，请勿在此填入真实密码。
 */

#ifndef SECRETS_H
#define SECRETS_H

// ──────────────── WiFi ────────────────
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ──────────────── MQTT 服务器 ────────────────
// 可以填公共测试 broker（如 broker.emqx.io），也可以填你自己的 mosquitto/EMQX
#define MQTT_SERVER     "broker.example.com"
#define MQTT_PORT       1883

// ──────────────── MQTT 主题 ────────────────
// 需与 K230 端 secrets.py 中的主题保持一致
#define TOPIC_PUB       "your_pub_topic"    // 本设备发布：{"temp":..,"humi":..}
#define TOPIC_SUB       "your_sub_topic"    // 本设备订阅：收到的内容原样打印到串口

#endif  // SECRETS_H
